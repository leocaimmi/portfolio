# Absolute public origin of the deployment. Used for canonical URLs,
# the sitemap and Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact form delivery (optional).
# Leave these unset and the contact section degrades to direct links
# instead of rendering a form that cannot deliver.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Inbox that receives the messages.
CONTACT_INBOX=""
# Verified sender address on your Resend domain. Before a domain is verified,
# Resend's shared sender works: onboarding@resend.dev
CONTACT_SENDER=""

# Human check on the contact form (optional).
# Both halves or neither: a widget with no secret is not checked, and a secret
# with no widget cannot be satisfied. Create a site at
# https://dash.cloudflare.com/?to=/:account/turnstile
# It does not require the domain's DNS to be on Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
